# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_hex_32
DEBUG=true

# ─── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=aiemployee
POSTGRES_PASSWORD=aiemployee_secret
POSTGRES_DB=ai_employee_db
DATABASE_URL=postgresql+asyncpg://aiemployee:aiemployee_secret@localhost:5432/ai_employee_db

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Google / Gemini ───────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_REGION=us-central1

# ─── Meta WhatsApp Cloud API ───────────────────────────────────────────────────
# Docs: https://developers.facebook.com/docs/whatsapp/cloud-api/
# 1. Create a Meta Developer App at https://developers.facebook.com/
# 2. Add the WhatsApp product to your app
# 3. Generate a System User Access Token (permanent token recommended)
# 4. Note your Phone Number ID and Business Account ID from the WA dashboard

META_WHATSAPP_ACCESS_TOKEN=          # System user permanent access token
META_WHATSAPP_PHONE_NUMBER_ID=       # Phone Number ID (not the phone number itself)
META_WHATSAPP_BUSINESS_ACCOUNT_ID=   # WhatsApp Business Account ID
META_GRAPH_API_VERSION=v20.0         # Meta Graph API version
META_WHATSAPP_VERIFY_TOKEN=          # Any string you choose for webhook verification
META_APP_SECRET=                     # App Secret (from App Settings → Basic)
WHATSAPP_ENABLED=true

# ─── Exotel Voice API (India) ──────────────────────────────────────────────────
# Docs: https://developer.exotel.com/
# Trial: https://docs.exotel.com/business-phone-system/create-a-trial-account
# AgentStream (Voice AI): https://developer.exotel.com/docs/agentstream/connect-voice-ai
#
# 1. Sign up at https://my.exotel.com/
# 2. Get Account SID from dashboard
# 3. Create API Key + Token in Settings → API
# 4. Buy/assign an ExoPhone (DID number)
# 5. Set base URL for your account region (India: api.exotel.com)

EXOTEL_ACCOUNT_SID=                  # Your Exotel Account SID (subdomain)
EXOTEL_API_KEY=                      # API Key (used as HTTP Basic Auth username)
EXOTEL_API_TOKEN=                    # API Token (used as HTTP Basic Auth password)
EXOTEL_API_BASE_URL=                 # e.g. https://api.exotel.com/v1/Accounts/{YOUR_ACCOUNT_SID}
EXOTEL_CALLER_ID=                    # Your ExoPhone / DID number (e.g. +914040XXXXXX)
EXOTEL_STREAM_URL=                   # wss:// endpoint for AgentStream Voice AI (optional)
EXOTEL_APP_OR_FLOW_URL=              # Exotel App/Flow URL for inbound call routing (optional)
EXOTEL_VOICE_ENABLED=true

# ─── Escalation ────────────────────────────────────────────────────────────────
# Phone number to dial when AI escalates to a human
ESCALATION_PHONE=
# WhatsApp number to alert when a hot lead is created or escalation happens
TEAM_WHATSAPP_PHONE=
ESCALATION_DIAL_TIMEOUT=30

# ─── Public / Webhook URLs ─────────────────────────────────────────────────────
# Set PUBLIC_BASE_URL to your tunnel URL during development (e.g. ngrok https URL)
# Meta and Exotel require publicly reachable HTTPS endpoints for webhooks
PUBLIC_BASE_URL=http://localhost:8000
# WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok-free.app  # uncomment when using tunnel

# ─── HubSpot CRM ───────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_access_token
HUBSPOT_PORTAL_ID=your_hubspot_portal_id

# ─── Google Calendar ───────────────────────────────────────────────────────────
GOOGLE_CALENDAR_CREDENTIALS_JSON=path/to/credentials.json
GOOGLE_CALENDAR_TOKEN_JSON=path/to/token.json

# ─── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
